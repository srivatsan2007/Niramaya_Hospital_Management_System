# ==============================================================================
# NIRAMAYA SMART HOSPITAL MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env for local testing or configure these keys in Render Dashboard.
# NEVER commit populated .env files with real production passwords to public Git.

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# The port the server listens on (Render automatically supplies PORT=10000)
PORT=10000

# ------------------------------------------------------------------------------
# 2. PRIMARY POSTGRESQL DATABASE (NEON / RENDER / SUPABASE / CLOUD POSTGRESQL)
# ------------------------------------------------------------------------------
# Option A: Standard Render PostgreSQL connection string (auto-injected by Render if using Render Postgres)
# Format: postgres://username:password@hostname:5432/databasename
DATABASE_URL=postgres://neondb_owner:your_password_here@ep-old-boat-axlruvbe-pooler.c-4.us-east-2.aws.neon.tech:5432/neondb?sslmode=require

# Option B: Direct JDBC Connection parameters (used by Neon PostgreSQL integration)
NEON_DB_URL=jdbc:postgresql://ep-old-boat-axlruvbe-pooler.c-4.us-east-2.aws.neon.tech:5432/neondb?sslmode=require&connectTimeout=5&socketTimeout=5
NEON_DB_USER=neondb_owner
NEON_DB_PASS=your_neon_password_here

# Option C: Generic PostgreSQL JDBC parameters
POSTGRES_URL=jdbc:postgresql://your-db-host:5432/your_database?sslmode=require
POSTGRES_USER=your_db_username
POSTGRES_PASS=your_db_password

# ------------------------------------------------------------------------------
# 3. SQLITE EMBEDDED FALLBACK & PERSISTENT DISK STORAGE
# ------------------------------------------------------------------------------
# Path to SQLite database file. On Render Web Services with a Persistent Disk mounted,
# set this to the persistent mount path (e.g. /data/niramaya_hospitals.db).
SQLITE_PATH=niramaya_hospitals.db
